{
  "name": "strikeblink",
  "version": "0.1.0",
  "description": "Solana Actions/Blinks for short-dated strike prediction markets on PREDICT pm-AMM (devnet). MLH Solana Hackathon entry.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/*.ts src/helpers/*.ts --platform=node --format=cjs --outbase=src --outdir=dist",
    "start": "node dist/server.js",
    "dev": "npm run build && node --watch dist/server.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:local": "node scripts/smoke-test.cjs",
    "test:live": "npm run build && node scripts/live-test.cjs"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.0",
    "@hono/node-server": "^2.1.6",
    "@pm-amm/sdk": "^0.2.0",
    "@solana/actions": "^1.6.6",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
